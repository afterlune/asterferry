{
  "name": "asterferry-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22 <25",
    "npm": ">=11 <13"
  },
  "scripts": {
    "build": "vue-tsc --noEmit && vite build",
    "dev": "vite",
    "generate:api": "openapi-typescript ../../internal/controller/openapi.yaml -o src/generated/controller-api.d.ts",
    "check:api": "npm run generate:api && git diff --exit-code -- src/generated/controller-api.d.ts",
    "lint": "vue-tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0",
    "vue": "3.5.43",
    "vue-router": "5.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/test-utils": "2.5.1",
    "happy-dom": "20.14.5",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vitest": "4.1.11",
    "vue-tsc": "3.3.11"
  },
  "overrides": {
    "glob": "10.5.0"
  }
}
